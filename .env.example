# =============================================================================
# incident-sense — example environment file
# -----------------------------------------------------------------------------
# Copy this file to ".env" and fill in your own keys:
#     cp .env.example .env
# The real ".env" is gitignored and must NEVER be committed.
# Values below are fictional placeholders for a demo of the fictional
# "Banco Meridiano". They are NOT anyone's production values.
# =============================================================================

# --- LLM / embedding providers -----------------------------------------------
# One OpenRouter key runs everything: chat, cluster labeling and embeddings
# (OpenRouter serves OpenAI's text-embedding-3-large).
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here

# Chat model used for summarization, post-filter, classification and labels.
# Configurable on purpose. Alternative example: openai/gpt-6-luna
LLM_MODEL=anthropic/claude-haiku-5.5

# Embedding model. Vector size MUST stay 3072 (Qdrant collection is sized to it).
EMBEDDING_MODEL=openai/text-embedding-3-large

# --- Vector database ---------------------------------------------------------
# Local Qdrant. In docker compose this is overridden to http://qdrant:6333.
# Use ":memory:" to run Qdrant in-process (no server; how the public demo runs).
QDRANT_URL=http://localhost:6333

# --- Retrieval (values from the reference, Ferreira (2026); configuration, not
# constants) -------------------------------------------------------------------
RETRIEVAL_MIN_SIMILARITY=0.8
INCIDENT_TOP_K=5
PROBLEM_TOP_K=10

# --- Frontend ----------------------------------------------------------------
# Public base URL the browser uses to reach the backend API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Backend tuning (illustrative example values, not production tuning) ------
LOG_LEVEL=INFO
# CORS: frontend origins allowed to call the API (comma-separated).
FRONTEND_ORIGIN=http://localhost:3000
